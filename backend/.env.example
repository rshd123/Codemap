NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
LLM_API_KEY=your-groq-api-key

# ETL (Phase 4) — optional but strongly recommended for GitHub ingestion
# Unauthenticated GitHub allows 60 requests/hour; a token raises that to 5000/hour.
